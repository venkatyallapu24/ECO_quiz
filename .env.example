# EcoQuest Environment Variables Template
# Copy to .env.local for local development. Never commit .env files with real credentials.

# Public Supabase API configuration (Stage 9 backend integration)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Application runtime environment
VITE_APP_ENV=development
VITE_APP_NAME=EcoQuest
